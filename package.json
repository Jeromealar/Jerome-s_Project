{
  "name": "rafa-website",
  "version": "1.0.0",
  "private": true,
  "description": "RAFA public website and shared backend",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch server/src/server.ts",
    "build": "tsc -p tsconfig.json && node scripts/copy-public.mjs",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "create-admin": "tsx server/scripts/create-admin.ts",
    "seed": "tsx server/scripts/seed.ts",
    "test": "vitest run",
    "check-links": "node tools/check-links.mjs"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.18",
    "better-auth": "^1.7.18",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.4",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "file-type": "^22.3.0",
    "helmet": "^8.0.0",
    "multer": "^2.5.0",
    "mysql2": "^3.12.0",
    "nodemailer": "^10.4.0",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^6.0.2",
    "drizzle-kit": "^0.31.11",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^5.1.0"
  }
}
